# tools/db-setup — ENTORNO PROPIO DE ESTE SCRIPT
# Copia este archivo a .env y ajusta los valores:
#     copy tools\db-setup\.env.example tools\db-setup\.env
#
# Con esto el script crea el rol y las bases, y GENERA:
#   - .env de la raíz (backend + VITE_*)
#   - apps/front/.env y apps/admin/.env
#   - dev-env.ps1 y dev-env.sh (para exportar las variables de backend en la sesión)

# --- Conexión al servidor PostgreSQL ---
# El script se conecta por TCP (no necesita psql en el PATH).
PGHOST=localhost
PGPORT=5432

# Superusuario: es el único que puede crear roles y bases (CREATE ROLE / CREATE DATABASE).
# Si no lo tienes, crea el rol y las bases a mano y ejecuta: npm run db:migrate
PGSUPERUSER=postgres
PGSUPERPASSWORD=cambia_esta_password_del_superusuario

# --- Bases de datos ---
DB_NAME=servitec
DB_TEST_NAME=servitec_test

# --- Rol de la aplicación (lo usa el backend) ---
APP_DB_USER=servitec
APP_DB_PASSWORD=cambia_esta_password

# --- Backend / fronts ---
# JWT_SECRET: si se deja vacío, el script genera uno aleatorio y lo guarda en el .env de la raíz.
JWT_SECRET=
API_PORT=8080
VITE_API_URL=http://localhost:8080
VITE_ADMIN_URL=http://localhost:5174

# Ubicación de las migraciones que consume Flyway (relativa a apps/api).
SPRING_FLYWAY_LOCATIONS=filesystem:../../db/migrations
