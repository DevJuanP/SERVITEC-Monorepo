# Copia este archivo a apps/front/.env y ajusta si hace falta.
# Todos los puertos son configurables: no hay puertos literales en el código.

# URL base de la API (Spring Boot). Por defecto: http://localhost:$SERVER_PORT
VITE_API_URL=http://localhost:8080

# URL del panel de administración (enlace del Header para admin/asesor).
VITE_ADMIN_URL=http://localhost:5174

# Puerto del dev server de este front (vite.config.js). Debe estar incluido en
# CORS_ALLOWED_ORIGINS del backend.
VITE_PORT=5173
