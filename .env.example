# Copia este archivo a .env y ajusta los valores.
# Referencia rápida de TODO lo configurable del monorepo. Ningún puerto está
# escrito en el código: todos salen de estas variables.
#
# Nota: Spring Boot NO lee este archivo. Para el backend hay que exportar las
# variables en la sesión (o usar dev-env.ps1, que genera tools/db-setup).

# --- Puertos e URLs (los usan el backend y los fronts) ---
# Puerto de la API         -> SERVER_PORT       (apps/api/src/main/resources/application.yml)
# Puerto del front público -> VITE_PORT         (apps/front/.env + vite.config.js)
# Puerto del panel admin   -> VITE_PORT         (apps/admin/.env + vite.config.js)
SERVER_PORT=8080
VITE_API_URL=http://localhost:8080
VITE_ADMIN_URL=http://localhost:5174
VITE_PORT=5173

# --- Backend (apps/api) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/servitec
SPRING_DATASOURCE_USERNAME=servitec
SPRING_DATASOURCE_PASSWORD=cambia_esta_password
JWT_SECRET=cambia_este_secreto_super_seguro

# Orígenes permitidos por CORS (los fronts), separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
